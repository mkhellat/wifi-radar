#!/bin/sh
# configure -- detect build prerequisites and write config.mk
# POSIX-compliant. No bashisms.
set -e

# Defaults
PREFIX="${PREFIX:-/usr/local}"
PYTHON="${PYTHON:-python3}"
VENV_DIR="${VENV_DIR:-.venv}"
SPHINX_BUILD=""
INSTALL_EXTRAS=""

# --- Helpers ----------------------------------------------------------------

die() { printf 'configure: error: %s\n' "$1" >&2; exit 1; }
info() { printf '  %-20s %s\n' "$1" "$2"; }
found() { info "$1" "$2 ... found"; }
missing() { info "$1" "(not found, optional)"; }

usage() {
    cat <<'EOF'
Usage: ./configure [OPTIONS]

Detect build prerequisites and generate config.mk.

Options:
  --prefix=DIR        Installation prefix        [/usr/local]
  --python=PATH       Python 3 interpreter       [python3]
  --venv=DIR          Virtual-environment path   [.venv]
  --with-docs         Include documentation deps in venv
  --help              Show this help and exit

Environment variables:
  PREFIX              Same as --prefix
  PYTHON              Same as --python
  VENV_DIR            Same as --venv

After running configure, use `make` to build.
Run `make help` for a list of all targets.
EOF
    exit 0
}

# --- Parse arguments --------------------------------------------------------

for arg in "$@"; do
    case "$arg" in
        --prefix=*)   PREFIX="${arg#*=}" ;;
        --python=*)   PYTHON="${arg#*=}" ;;
        --venv=*)     VENV_DIR="${arg#*=}" ;;
        --with-docs)  INSTALL_EXTRAS="docs" ;;
        --help|-h)    usage ;;
        *)            die "unknown option: $arg" ;;
    esac
done

# --- Check Python -----------------------------------------------------------

printf 'Checking build prerequisites...\n'

if ! command -v "$PYTHON" >/dev/null 2>&1; then
    die "$PYTHON not found. Set PYTHON= or --python= to a Python 3.11+ interpreter."
fi

PY_VERSION=$("$PYTHON" -c 'import sys; print(f"{sys.version_info.major}.{sys.version_info.minor}")')
PY_MAJOR=$("$PYTHON" -c 'import sys; print(sys.version_info.major)')
PY_MINOR=$("$PYTHON" -c 'import sys; print(sys.version_info.minor)')

if [ "$PY_MAJOR" -lt 3 ] || { [ "$PY_MAJOR" -eq 3 ] && [ "$PY_MINOR" -lt 11 ]; }; then
    die "Python >= 3.11 required (found $PY_VERSION)"
fi
found "python" "$PYTHON ($PY_VERSION)"

# --- Check venv module ------------------------------------------------------

if ! "$PYTHON" -c 'import venv' 2>/dev/null; then
    die "Python venv module not available. Install python3-venv or equivalent."
fi
found "venv module" "available"

# --- Check system tools (informational) -------------------------------------

for tool in iw ip airodump-ng tshark; do
    if command -v "$tool" >/dev/null 2>&1; then
        found "$tool" "$(command -v "$tool")"
    else
        missing "$tool"
    fi
done

# --- Check sphinx-build (for docs) ------------------------------------------

if command -v sphinx-build >/dev/null 2>&1; then
    SPHINX_BUILD="sphinx-build"
    found "sphinx-build" "$(command -v sphinx-build)"
elif [ -x "$VENV_DIR/bin/sphinx-build" ]; then
    SPHINX_BUILD="$VENV_DIR/bin/sphinx-build"
    found "sphinx-build" "$SPHINX_BUILD (in venv)"
fi

# --- Check make -------------------------------------------------------------

if ! command -v make >/dev/null 2>&1; then
    die "GNU make not found. Install make."
fi
found "make" "$(command -v make)"

# --- Write config.mk --------------------------------------------------------

cat > config.mk <<CONF
# Generated by ./configure on $(date -u +%Y-%m-%dT%H:%M:%SZ)
# Do not edit; re-run ./configure to regenerate.

PREFIX        := $PREFIX
PYTHON        := $PYTHON
PY_VERSION    := $PY_VERSION
VENV_DIR      := $VENV_DIR
SPHINX_BUILD  := $SPHINX_BUILD
INSTALL_EXTRAS := $INSTALL_EXTRAS
CONF

printf '\nConfiguration written to config.mk\n'
printf 'Run `make` to create venv and install, or `make help` for targets.\n'
